<!--
  サービスID実行（Service Identity）ポリシー
  Lab 3 — On-call Schedule MCP Server 用

  アプリトークン（Managed Identity / サービスプリンシパル）でインバウンド認証します。
  ユーザーコンテキストは不要なシナリオ向け（X-User-Id 注入なし）。
-->
<policies>
    <inbound>
        <base />
        <!-- パターンB: アプリトークン（MI / サービスプリンシパル）でインバウンド認証 -->
        <validate-azure-ad-token
            tenant-id="{{EntraTenantId}}"
            header-name="Authorization"
            failed-validation-httpcode="401"
            failed-validation-error-message="Unauthorized: Invalid or missing token">
            <audiences>
                <audience>{{McpServerAppId}}</audience>
            </audiences>
        </validate-azure-ad-token>
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
