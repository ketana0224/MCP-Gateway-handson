// ============================================================
// MCP Gateway 監査ダッシュボード KQL クエリ集
// Lab 4 で使用
// ============================================================

// -----------------------------------------------------------
// 1. MCP ツール呼び出し状況（時系列）
// -----------------------------------------------------------
ApiManagementGatewayMCPLog
| where TimeGenerated > ago(1h)
| summarize
    totalCalls = count(),
    errorCalls = countif(ResponseCode >= 400),
    avgDuration = avg(DurationMs)
  by ApiId, bin(TimeGenerated, 5m)
| render timechart

// -----------------------------------------------------------
// 2. MCP ログと Gateway ログの相関結合
// -----------------------------------------------------------
ApiManagementGatewayMCPLog
| where TimeGenerated > ago(1h)
| join kind=leftouter (
    ApiManagementGatewayLogs
    | project CorrelationId, DurationMs, ResponseCode, ApiId, OperationId
) on CorrelationId
| project TimeGenerated, CorrelationId, ApiId, OperationId, DurationMs, ResponseCode

// -----------------------------------------------------------
// 3. セッション別アクティビティ Top 20
// -----------------------------------------------------------
ApiManagementGatewayMCPLog
| where TimeGenerated > ago(1h)
| summarize
    requestCount = count(),
    errors = countif(ResponseCode >= 400)
  by CorrelationId
| order by requestCount desc
| take 20

// -----------------------------------------------------------
// 4. レート制限（429）発生状況
// -----------------------------------------------------------
ApiManagementGatewayLogs
| where TimeGenerated > ago(1h)
| where ResponseCode == 429
| summarize hitCount = count() by ApiId, bin(TimeGenerated, 5m)
| render barchart

// -----------------------------------------------------------
// 5. 認証エラー（401 / 403）の発生状況
// -----------------------------------------------------------
ApiManagementGatewayLogs
| where TimeGenerated > ago(1h)
| where ResponseCode in (401, 403)
| summarize count() by ResponseCode, ApiId, bin(TimeGenerated, 10m)
| render timechart

// -----------------------------------------------------------
// 6. Application Insights との相関（W3C Trace Context）
// -----------------------------------------------------------
requests
| extend apimCorrelationId = tostring(customDimensions["CorrelationId"])
| where isnotempty(apimCorrelationId)
| join kind=leftouter (
    ApiManagementGatewayLogs
    | project CorrelationId, ApiId, OperationId
) on $left.apimCorrelationId == $right.CorrelationId
| project timestamp, name, duration, apimCorrelationId, ApiId, OperationId

// -----------------------------------------------------------
// 7. ユーザー別ツール利用頻度（X-User-Id ヘッダー使用時）
// -----------------------------------------------------------
ApiManagementGatewayLogs
| where TimeGenerated > ago(24h)
| extend userId = tostring(parse_json(RequestHeaders)["X-User-Id"])
| where isnotempty(userId) and userId != "unknown"
| summarize toolCalls = count() by userId, ApiId
| order by toolCalls desc
